+                <td style={td}>{i.email}</td>
+                <td style={td}>{i.invitedByName}</td>
+                <td style={td}>{new Date(i.issuedAt).toLocaleString()}</td>
+                <td style={td}><span style={{ ...badge, ...inviteStatusStyle(i.status) }}>{i.status}</span></td>
+              </tr>
+            ))}
+          </tbody>
+        </table>
+      )}
+    </Panel>
+  );
+}
